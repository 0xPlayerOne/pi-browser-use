{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "ignorePatterns": [
    "CHANGELOG.md",
    ".github/.code-foundry",
    ".github/actions/",
    "plugin.json",
    "skills/",
    "node_modules/",
    "dist/",
    "coverage/"
  ],
  "overrides": [
    {
      "files": ["plugin.json"],
      "options": {
        "printWidth": 60
      }
    }
  ]
}
