{
  "name": "pi-browser-use",
  "version": "0.11.4",
  "description": "Opinionated browser automation via chrome-devtools-mcp: native Pi extension and portable Agent Plugins 1.0 skills + MCP server.",
  "keywords": [
    "automation",
    "browser",
    "chrome-devtools",
    "extension",
    "mcp",
    "pi",
    "pi-package"
  ],
  "homepage": "https://github.com/0xPlayerOne/pi-browser-use#readme",
  "bugs": {
    "url": "https://github.com/0xPlayerOne/pi-browser-use/issues"
  },
  "license": "MIT",
  "author": "0xPlayerOne",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPlayerOne/pi-browser-use.git"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "docs/performance.md",
    "extension",
    "skills",
    "README.md",
    "plugin.json",
    "mcp.json",
    "docs/agent-plugins.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prebuild": "tsc -b --clean tsconfig.json",
    "format:check": "oxfmt --check .",
    "fmt": "oxfmt .",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "bench": "node scripts/bench.mjs",
    "eval": "node scripts/eval.mjs",
    "preeval": "npm run build",
    "test": "node --test test/*.test.mjs",
    "preperf:audit": "npm run build",
    "perf:audit": "node scripts/performance.mjs",
    "preperf:check": "npm run build",
    "perf:check": "node scripts/performance.mjs --check",
    "pretest": "npm run build",
    "test:smoke": "npm run build && node scripts/plugin-smoke.mjs",
    "test:browser": "npm run build && node scripts/plugin-smoke.mjs --browser"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chrome-devtools-mcp": "1.8.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@types/node": "^22.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.10",
    "@earendil-works/pi-coding-agent": ">=0.80.10"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  }
}
