{
  "name": "pi-browser-use",
  "version": "0.9.0",
  "description": "Opinionated browser-use for the Pi coding agent, powered by chrome-devtools-mcp (not Playwright). Fresh headless by default, authenticated persistent profile opt-in, CLI-first policy bundled.",
  "keywords": [
    "automation",
    "browser",
    "chrome-devtools",
    "extension",
    "mcp",
    "pi",
    "pi-package"
  ],
  "homepage": "https://github.com/0xPlayerOne/pi-browser-use#readme",
  "bugs": {
    "url": "https://github.com/0xPlayerOne/pi-browser-use/issues"
  },
  "license": "MIT",
  "author": "0xPlayerOne",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPlayerOne/pi-browser-use.git"
  },
  "files": [
    "dist",
    "extension",
    "skills",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format:check": "oxfmt --check .",
    "fmt": "oxfmt .",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "bench": "node scripts/bench.mjs",
    "test": "node --test test/*.test.mjs",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chrome-devtools-mcp": "1.8.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@types/node": "^22.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.10",
    "@earendil-works/pi-coding-agent": ">=0.80.10"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  }
}
